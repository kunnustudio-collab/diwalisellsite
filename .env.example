# DeepAura — Diwali Decor Environment Variables Example
# Copy this file to .env.local to configure your custom environment

# Admin Security & Auth
ADMIN_JWT_SECRET=your_super_secret_jwt_key_min_32_chars
INITIAL_ADMIN_EMAIL=admin@deepaura.com
INITIAL_ADMIN_PASSWORD=DeepAura@Festive2026

# YouPI-PG Sovereign UPI Payment Gateway (0% Fees, Direct Bank Settlement)
# Self-hosted gateway repository: https://github.com/youpi-pg/YouPI-PG
NEXT_PUBLIC_YOUPI_URL=http://localhost:7000
NEXT_PUBLIC_YOUPI_MERCHANT_KEY=yp_live_your_merchant_key
YOUPI_WEBHOOK_SECRET=your_youpi_webhook_hmac_secret

# Supabase Configuration (Optional for Cloud DB, local fallback active by default)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay Online Payments (Optional - Cash on Delivery & YouPI UPI active by default)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI Provider for Admin Review Assistant (Optional - Gemini API or OpenAI)
GEMINI_API_KEY=

# Store Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:8080
PORT=8080
